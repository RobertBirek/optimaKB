{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.4-mini-fast",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".agents/skills",
      ".opencode/skills"
    ]
  },
  "references": {
    "docs": {
      "path": "docs/reference",
      "description": "OpenSPG KB: operational memory, API quirks, pipeline guides, routing rules, inbox workflow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "apiKey": "{file:/docker/openspg/.opencode/.google-api-key}"
      }
    }
  },
  "permission": {
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "data/**": "deny",
      "*": "allow"
    },
    "edit": {
      "data/**": "deny",
      "backups/**": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "node_modules/**": "deny",
      "*": "ask"
    },
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "docker *": "allow",
      "node *": "allow",
      "*": "ask"
    }
  },
  "formatter": true
}
