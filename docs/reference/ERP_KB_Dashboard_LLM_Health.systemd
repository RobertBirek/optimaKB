[Unit]
Description=ERP KB Dashboard reviewer LLM health check
After=network-online.target erp-kb-dashboard.service
Wants=network-online.target

[Service]
Type=oneshot
User=mcpbot
Group=mcpbot
WorkingDirectory=/docker/openspg
EnvironmentFile=/etc/erp-kb-dashboard.env
LoadCredential=openspg.cookie:/etc/erp-kb-openspg.cookie
Environment=OPENSPG_LLM_APP_ID=4
Environment=OPENSPG_LLM_SESSION_ID=57
Environment=OPENSPG_LLM_MODEL=gpt-5.4-mini
Environment=OPENSPG_COOKIE_FILE=%d/openspg.cookie
Environment=ERP_KB_AUTOMATION_ALLOWED_NAMESPACES=ComarchCommunityNews
Environment=ERP_KB_AUTOMATION_SHADOW_ONLY=1
ExecStart=/usr/bin/node /docker/openspg/scripts/check_dashboard_llm_health.mjs
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RemoveIPC=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/docker/openspg/scripts
ReadWritePaths=/docker/openspg/data
ReadWritePaths=/docker/openspg/docs/reference
