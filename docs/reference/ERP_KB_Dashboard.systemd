[Unit]
Description=ERP KB Web Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/docker/openspg
EnvironmentFile=/etc/erp-kb-dashboard.env
ExecStart=/usr/bin/node /docker/openspg/scripts/erp_kb_dashboard_server.mjs
Restart=always
RestartSec=3
User=mcpbot
Group=mcpbot
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RemoveIPC=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=

ReadOnlyPaths=/docker/openspg/scripts
ReadOnlyPaths=/docker/openspg/src
ReadOnlyPaths=/docker/openspg/dist
ReadOnlyPaths=/docker/openspg/package.json
ReadOnlyPaths=/docker/openspg/package-lock.json
ReadWritePaths=/docker/openspg/data
ReadWritePaths=/docker/openspg/downloads
ReadWritePaths=/docker/openspg/docs/reference
ReadWritePaths=/docker/openspg/exports
ReadWritePaths=/docker/openspg/logs

[Install]
WantedBy=multi-user.target
