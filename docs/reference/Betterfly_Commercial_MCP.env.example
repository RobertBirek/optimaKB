# Betterfly API tenant configuration
BETTERFLY_API_BASE_URL=https://app.comarchbetterfly.pl
BETTERFLY_CLIENT_ID=your_client_id
BETTERFLY_CLIENT_SECRET=your_client_secret

# Privacy controls
# strict_privacy | trusted_operator
BETTERFLY_MCP_PRIVACY_MODE=strict_privacy
# Must be true to allow includeSensitive=true in trusted_operator mode
BETTERFLY_MCP_ALLOW_SENSITIVE=false

# Read limits
BETTERFLY_MCP_DEFAULT_PAGE_SIZE=10
BETTERFLY_MCP_MAX_PAGE_SIZE=25
BETTERFLY_MCP_REQUEST_TIMEOUT_MS=30000

# Stdio transport
BETTERFLY_MCP_MAX_FRAME_BYTES=1048576

# HTTP/SSE bridge transport
BETTERFLY_MCP_HTTP_HOST=127.0.0.1
BETTERFLY_MCP_HTTP_PORT=3500
BETTERFLY_MCP_HTTP_PATH=/mcp
BETTERFLY_MCP_LEGACY_SSE_PATH=/sse
BETTERFLY_MCP_HTTP_TOKEN=replace_with_long_random_token
BETTERFLY_MCP_HTTP_MAX_BODY_BYTES=1048576
BETTERFLY_MCP_HTTP_MAX_SSE_CLIENTS=50
BETTERFLY_MCP_HTTP_REQUEST_TIMEOUT_MS=30000
BETTERFLY_MCP_HTTP_HEADERS_TIMEOUT_MS=10000
BETTERFLY_MCP_HTTP_SSE_KEEPALIVE_MS=15000
