ROOT=/docker/openspg
ERP_KB_DASHBOARD_HOST=10.10.254.42
ERP_KB_DASHBOARD_PORT=3410
ERP_KB_DASHBOARD_BASE_PATH=/panel
ERP_KB_DASHBOARD_USER=mcpadmin
ERP_KB_DASHBOARD_PASSWORD=change-me
# Optional lower-privilege accounts. The primary account above is admin.
ERP_KB_DASHBOARD_OPERATOR_USER=
ERP_KB_DASHBOARD_OPERATOR_PASSWORD=
ERP_KB_DASHBOARD_VIEWER_USER=
ERP_KB_DASHBOARD_VIEWER_PASSWORD=
ERP_KB_DASHBOARD_MAX_BODY_BYTES=15728640
ERP_KB_DASHBOARD_REQUEST_TIMEOUT_MS=45000
ERP_KB_DASHBOARD_RATE_WINDOW_MS=60000
ERP_KB_DASHBOARD_RATE_READ=240
ERP_KB_DASHBOARD_RATE_WRITE=60

# Draft metadata analysis and automatic LLM review.
OPENSPG_API_BASE=http://10.10.254.42:8887
ERP_KB_MCP_BASE_URL=http://10.10.254.42:3400
OPENSPG_LLM_ENDPOINT=/v1/chat/completions
OPENSPG_LLM_APP_ID=
OPENSPG_LLM_SESSION_ID=
OPENSPG_LLM_MODEL=
OPENSPG_COOKIE_FILE=/etc/erp-kb-openspg.cookie

# Keep publication disabled until shadow results are accepted.
ERP_KB_AUTOMATION_ENABLED=0
ERP_KB_AUTOMATION_SHADOW_ONLY=1
ERP_KB_AUTOMATION_ALLOWED_NAMESPACES=ComarchCommunityNews
ERP_KB_AUTOMATION_MIN_CONFIDENCE=0.90
ERP_KB_AUTOMATION_LLM_INPUT_MAX_CHARS=12000
ERP_KB_AUTOMATION_LLM_TIMEOUT_MS=60000
ERP_KB_AUTOMATION_LOCK_STALE_MS=21600000
ERP_KB_AUTOMATION_CANARY_MIN_SAMPLES=20
ERP_KB_AUTOMATION_CANARY_MIN_ACCURACY=0.95
ERP_KB_AUTOMATION_CANARY_MAX_FALSE_POSITIVES=0
ERP_KB_AUTOMATION_LLM_HEALTH_TIMEOUT_MS=90000
ERP_KB_AUTOMATION_LLM_HEALTH_FAILURE_THRESHOLD=2
ERP_KB_AUTOMATION_LLM_HEALTH_MAX_AGE_MS=1800000
ERP_KB_DASHBOARD_AUDIT_LOCK_STALE_MS=30000

# Source fetches reject localhost/private IPs and validate every redirect.
ERP_KB_ALLOW_PRIVATE_SOURCE_URLS=0
ERP_KB_SOURCE_MAX_REDIRECTS=5
ERP_KB_SOURCE_SCAN_CRON_SCHEDULE=25 4 * * *

# Source discovery. Production timers force dry-run independently.
ERP_KB_DISCOVERY_DRY_RUN=1
ERP_KB_DISCOVERY_LLM_MODEL=deepseek-reasoner
ERP_KB_DISCOVERY_LLM_TIMEOUT_MS=90000
ERP_KB_DISCOVERY_CONCURRENCY=3
