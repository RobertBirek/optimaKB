		description(description): Text
		name(name): Text
		semanticType(semanticType): Text
			index: Text
		canonicalName(canonicalName): Text
			index: Text
		ontologyId(ontologyId): Text
			index: Text
		verificationStatus(verificationStatus): Text
		confidenceLevel(confidenceLevel): Text
