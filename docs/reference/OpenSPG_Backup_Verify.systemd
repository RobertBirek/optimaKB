[Unit]
Description=Verify latest OpenSPG backup snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/docker/openspg
Environment=HOME=/tmp
Environment=OPENSPG_BACKUP_ROOT=/docker/openspg/backups/automated
Environment=OPENSPG_BACKUP_VERIFY_TIMEOUT_MS=600000
Environment=OPENSPG_BACKUP_VERIFY_REPORT=/var/lib/openspg-backup/verification-report.json
ExecStart=/usr/bin/node /docker/openspg/scripts/verify_openspg_backup_snapshot.mjs
TimeoutStartSec=25min
UMask=0077
StateDirectory=openspg-backup
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RemoveIPC=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=

ReadOnlyPaths=/docker/openspg/backups
ReadOnlyPaths=/docker/openspg/scripts
ReadWritePaths=/var/lib/openspg-backup
