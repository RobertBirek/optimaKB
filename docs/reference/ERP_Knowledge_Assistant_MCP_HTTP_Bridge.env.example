ROOT=/docker/openspg
ERP_KB_HTTP_HOST=127.0.0.1
ERP_KB_HTTP_PORT=3400
ERP_KB_HTTP_PATH=/mcp
ERP_KB_LEGACY_SSE_PATH=/sse
ERP_KB_HTTP_TOKEN=replace-me
ERP_KB_HTTP_WRITE_TOKEN=
ERP_KB_HTTP_MAX_BODY_BYTES=1048576
ERP_KB_HTTP_MAX_SSE_CLIENTS=50
ERP_KB_HTTP_REQUEST_TIMEOUT_MS=30000
ERP_KB_HTTP_HEADERS_TIMEOUT_MS=10000
ERP_KB_MCP_MAX_FRAME_BYTES=1048576
ERP_KB_DRAFT_MAX_TITLE_CHARS=200
ERP_KB_DRAFT_MAX_CONTENT_CHARS=50000
ERP_KB_DRAFT_MAX_SOURCE_URL_CHARS=2048
ERP_KB_DRAFT_MAX_TAGS=20
ERP_KB_DRAFT_MAX_TAG_CHARS=64
ERP_KB_DRAFT_MAX_PER_DAY=100
ERP_KB_AUTO_DRAFT_MAX_PER_DAY=25
