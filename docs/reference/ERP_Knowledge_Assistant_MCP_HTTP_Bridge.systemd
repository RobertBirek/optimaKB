[Unit]
Description=ERP Knowledge Assistant MCP HTTP Bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=/docker/openspg
Environment=ROOT=/docker/openspg
Environment=ERP_KB_HTTP_HOST=127.0.0.1
Environment=ERP_KB_HTTP_PORT=3400
Environment=ERP_KB_HTTP_PATH=/mcp
Environment=ERP_KB_HTTP_TOKEN=replace-me
ExecStart=/usr/bin/node /docker/openspg/scripts/erp_knowledge_mcp_http_bridge.mjs
Restart=always
RestartSec=3
User=mcpbot
Group=mcpbot

[Install]
WantedBy=multi-user.target
