{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "small_model": "google/gemini-2.0-flash",
  "skills": {
    "paths": [
      ".agents/skills",
      ".opencode/skills"
    ]
  },
  "references": {
    "docs": {
      "path": "docs/reference",
      "description": "OpenSPG KB: operational memory, API quirks, pipeline guides, routing rules, inbox workflow"
    }
  },
  "provider": {
    "google": {
      "options": {
        "apiKey": "{file:/docker/openspg/.opencode/.google-api-key}"
      }
    }
  },
  "permission": {
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "data/**": "deny",
      "*": "allow"
    },
    "edit": {
      "data/**": "deny",
      "backups/**": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "node_modules/**": "deny",
      "*": "ask"
    },
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "docker *": "allow",
      "node *": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "OWAOntology": {
      "type": "local",
      "command": [
        "node",
        "scripts/owa_ontology_mcp_server.mjs"
      ],
      "enabled": false,
      "env": {
        "OPTIMAKB_MCP_URL": "https://optima.kag.taxbell.pl/mcp",
        "OPTIMAKB_API_KEY": "sk-Vd0BGT7jO-Cvrtmqprh_UGUy4_EU7Cab",
        "EXA_API_KEY": "a792b402-aaa5-4cf7-ba92-e7d6cb052d09",
        "OPENSPG_COOKIE_FILE": "/etc/erp-kb-openspg.cookie",
        "ROOT": "/docker/openspg"
      }
    }
  },
  "formatter": true
}
