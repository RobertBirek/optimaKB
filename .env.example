TZ=Europe/Warsaw

# OpenSPG image digests (pinned for reproducibility).
# To scan for CVEs: install trivy (https://trivy.dev) and run:
#   trivy image --severity HIGH,CRITICAL <image>
# Current known versions (approximate, based on push dates):
OPENSPG_MYSQL_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-mysql@sha256:71eb546d5fc5faf70b3d8a358c022f601591b54a029b79298f2fa0302e46de9a    # built 2025-06-30 (MySQL 8.x)
OPENSPG_NEO4J_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-neo4j@sha256:4bc5b7f6b83d333b1d2c8f60ac145c068d77d50bca65b3a07c927f9e2a541eb9    # built 2024-11-20 (Neo4j 5.x) — OLDEST OF THE FOUR, POTRZEBUJE REFRESHU
OPENSPG_MINIO_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-minio@sha256:9493c8e8f77edb10d556255d49ba8b5761b0fe57889235dfd10619c0513da007   # built 2024-12-19 (MinIO RELEASE.2024-12-18) — POTRZEBUJE REFRESHU
OPENSPG_SERVER_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-server@sha256:fe6708deef9ebb8da8da7b1cb643e83b827769a5be8811961311639aa1f2cb88 # built 2025-07-03 (OpenSPG 1.0.x)
OPENSPG_TIKA_IMAGE=apache/tika@sha256:90b7fa1dc018434075fce9e1d9b88b1e3d0ea6979d0cf86e116c79a8073ae973 # pinned by digest (was apache/tika:latest — mutable tag, auto-updated nightly by Watchtower)

MYSQL_DATABASE=openspg
MYSQL_ROOT_PASSWORD=change-me
MYSQL_APP_USER=openspg_app
MYSQL_APP_PASSWORD=change-me

OPENSPG_NEO4J_USER=neo4j
OPENSPG_NEO4J_PASSWORD=change-me
OPENSPG_NEO4J_PASSWORD_URLENCODED=change-me-urlencoded

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ROOT_PASSWORD_URLENCODED=change-me-urlencoded

OPENSPG_BIND_ADDRESS=127.0.0.1
OPENSPG_PORT=8887
OPENSPG_SERVER_XMS=2048m
OPENSPG_SERVER_XMX=4096m
BUILDER_MODEL_EXECUTE_NUM=6

# Optional dashboard Add Draft integrations.
# Put the real EXA_API_KEY in /etc/erp-kb-dashboard.env for the systemd dashboard service.
EXA_API_KEY=
EXA_CONTENTS_API_URL=https://api.exa.ai/contents
EXA_REQUEST_TIMEOUT_MS=15000
OPENSPG_API_BASE=http://10.10.254.42:8887
OPENSPG_LLM_ENDPOINT=/v1/chat/completions
OPENSPG_LLM_MODEL=
OPENSPG_LLM_APP_ID=
OPENSPG_LLM_SESSION_ID=
ERP_KB_DRAFT_ANALYZE_MAX_CHARS=28000
ERP_KB_DRAFT_LLM_INPUT_MAX_CHARS=6000
